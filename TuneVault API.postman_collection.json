        {
          "name": "02 - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response success is true\", function () {",
                  "  pm.expect(json.success).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Response returns JWT token\", function () {",
                  "  pm.expect(json.data).to.exist;",
                  "  pm.expect(json.data).to.have.property(\"token\");",
                  "  pm.expect(json.data.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Token and userId are saved to collection variables\", function () {",
                  "  const token = json.data?.token;",
                  "",
                  "  const userId =",
                  "    json.data?.userId ??",
                  "    json.data?.userID ??",
                  "    json.data?.UserID ??",
                  "    json.data?.id ??",
                  "    json.data?.Id ??",
                  "    \"\";",
                  "",
                  "  pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(userId).to.be.a(\"string\").and.not.empty;",
                  "",
                  "  pm.collectionVariables.set(\"token\", token);",
                  "  pm.collectionVariables.set(\"userId\", userId);",
                  "",
                  "  console.log(\"SAVED TOKEN:\", token);",
                  "  console.log(\"SAVED USER ID:\", userId);",
                  "});",
                  "",
                  "pm.test(\"Token is saved to collection\", function () {",
                  "  pm.expect(pm.collectionVariables.get(\"token\")).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"UserId is saved to collection\", function () {",
                  "  pm.expect(pm.collectionVariables.get(\"userId\")).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000ms\", function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"thanhnhan@gmail.com\",\n  \"password\": \"123456\"\n\n}"
