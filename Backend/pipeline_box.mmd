%%{init: {'theme': 'dark'}}%%
graph TD
    subgraph auth ["1. AUTH PIPELINE"]
        RC[RegisterCommand] -->|1a. Validate| RV[RegisterValidator]
        RV -->|2a. Handle| RH[RegisterHandler]
        LC[LoginCommand] -->|1b. Handle| LH[LoginHandler]
        RH -->|3a| RD[AuthResponseDto]
        LH -->|3b| RD
    end

    subgraph upload ["2. UPLOAD MEDIA PIPELINE"]
        UC[UploadMediaCommand] -->|1. Validate| UV[UploadMediaValidator]
        UV -->|2. Handle| UH[UploadMediaHandler]
        UH -->|3. Output| UD[MediaItemDto]
    end

    subgraph streaming ["3. PLAYBACK & STREAMING PIPELINE"]
        GMC[GetMediaInfoQuery] -->|1. Handle| GMH[GetMediaInfoQueryHandler]
        GMH -->|2. Output| GMD[MediaItemDto]
    end

    subgraph share ["4. SHARE MEDIA PIPELINE"]
        SC[ShareMediaCommand] -->|1. Validate| SV[ShareMediaValidator]
        SV -->|2. Handle| SH[ShareMediaHandler]
        SH -->|3. Output| SD[ShareMediaResponseDto]
    end

    subgraph notifications ["5. REAL-TIME NOTIFICATIONS PIPELINE"]
        NC[GetNotificationsQuery] -->|1. Handle| NH[GetNotificationsHandler]
        NH -->|2. Output| ND["IEnumerable&lt;NotificationDto&gt;"]
    end

    subgraph playlist ["6. PLAYLIST MANAGEMENT PIPELINE"]
        CPC[CreatePlaylistCommand] -->|1. Handle| CPH[CreatePlaylistHandler]
        CPH -->|2. Output| CPD["int (PlaylistID)"]
    end

    subgraph favorite ["7. FAVORITE PIPELINE"]
        AFC[AddFavoriteCommand] -->|1. Handle| AFH[AddFavoriteHandler]
        AFH -->|2. Output| AFD["int (Result)"]
    end

    subgraph playhistory ["8. PLAY HISTORY PIPELINE"]
        PHC[RecordPlayHistoryCommand] -->|1. Handle| PHH[RecordPlayHistoryHandler]
        PHH -->|2. Output| PHD["int (Result)"]
    end

    subgraph ai_rec ["9. AI MUSIC RECOMMENDATION PIPELINE"]
        ARC[GetRecommendationsQuery] -->|1. Handle| ARH[GetRecommendationsQueryHandler]
        ARH -->|2. Output| ARD["List&lt;MediaItemRecommendationDto&gt;"]
    end

    subgraph ai_desc ["10. AI DESCRIPTION GENERATION PIPELINE"]
        ADC[GenerateMediaDescriptionCommand] -->|1. Handle| ADH[GenerateMediaDescriptionHandler]
        ADH -->|2. Output| ADD["string (Description)"]
    end

    %% Invisible links to force vertical stacking in correct order (1 to 10)
    RD ~~~ UC
    UD ~~~ GMC
    GMD ~~~ SC
    SD ~~~ NC
    ND ~~~ CPC
    CPD ~~~ AFC
    AFD ~~~ PHC
    PHD ~~~ ARC
    ARD ~~~ ADC

    style auth fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style upload fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style streaming fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style share fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style notifications fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style playlist fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style favorite fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style playhistory fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style ai_rec fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff
    style ai_desc fill:#111111,stroke:#333333,stroke-width:1px,color:#ffffff

    classDef bw fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000
    class RC,RV,RH,LC,LH,RD,UC,UV,UH,UD,GMC,GMH,GMD,SC,SV,SH,SD,NC,NH,ND,CPC,CPH,CPD,AFC,AFH,AFD,PHC,PHH,PHD,ARC,ARH,ARD,ADC,ADH,ADD bw;
