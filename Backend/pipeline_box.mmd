%%{init: {'theme': 'dark'}}%%
graph TD
    subgraph auth ["1. AUTH PIPELINE (Register / Login)"]
        RC[RegisterCommand] -->|1a. Validate Input DTO| RV[RegisterValidator]
        RV -->|2a. Create User, Hash Password & Gen JWT| RH[RegisterHandler]
        
        LC[LoginCommand] -->|1b. Verify Password & Gen JWT| LH[LoginHandler]
        
        RH -->|3a| RD[AuthResponseDto]
        LH -->|3b| RD
    end

    subgraph share ["2. SHARE MEDIA PIPELINE (Share)"]
        SC[ShareMediaCommand] -->|1. Validate Receiver, Media/Playlist ID| SV[ShareMediaValidator]
        SV -->|2. Check duplicates, insert Share & Notification, push SignalR| SH[ShareMediaHandler]
        SH -->|3. Return Share Record Details| SD[ShareMediaResponseDto]
    end

    subgraph notifications ["3. NOTIFICATIONS PIPELINE (Get Notifications)"]
        NC[GetNotificationsQuery] -->|1. Fetch Notifications from Database| NH[GetNotificationsHandler]
        NH -->|2. Return list of notifications| ND["IEnumerable&lt;NotificationDto&gt;"]
    end

    subgraph upload ["4. UPLOAD MEDIA PIPELINE (Upload)"]
        UC[UploadMediaCommand] -->|1. Validate File, Title, Format| UV[UploadMediaValidator]
        UV -->|2. Save File to Disk, insert MediaItem to DB| UH[UploadMediaHandler]
        UH -->|3. Return Uploaded Media metadata| UD[MediaItemDto]
    end

    subgraph follow ["5. FOLLOW PIPELINE (Follow User)"]
        FC[FollowCommand] -->|1. Create Follow record, insert Notification, push SignalR| FH[FollowHandler]
        FH -->|2. Return Created Follow ID| FD["int (FollowID)"]
    end

    %% Invisible links to force vertical stacking in correct order (1, 2, 3, 4, 5)
    RD ~~~ SC
    SD ~~~ NC
    ND ~~~ UC
    UD ~~~ FC

